{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "bash|web_fetch|web_search",
        "hooks": [
          {
            "type": "command",
            "name": "网络坏了自动 WiFi 重连",
            "command": "pwsh -NoProfile -File \"${MINIMAX_PROJECT_DIR}/tools/net-auto-recover.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${MINIMAX_PROJECT_DIR}/tools/net-auto-recover.ps1\"",
            "timeout": 9
          }
        ]
      }
    ]
  }
}
